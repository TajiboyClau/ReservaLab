{
  "name": "reservalab",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev:api": "pnpm --filter @reservalab/api dev",
    "predev:api": "pnpm --filter @reservalab/shared build",
    "build": "turbo run build",
    "build:api": "pnpm --filter @reservalab/shared build && pnpm --filter @reservalab/api build",
    "dev:web": "pnpm --filter @reservalab/web dev",
    "dev:cli": "pnpm --filter @reservalab/cli dev",
    "db:migrate": "pnpm --filter @reservalab/api db:migrate",
    "db:generate": "pnpm --filter @reservalab/api db:generate",
    "db:seed": "pnpm --filter @reservalab/api db:seed"
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  }
}
